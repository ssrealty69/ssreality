# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
./scripts/*
# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large media files
/public/SS Realty Review, Gurgaon Best Real Estate SS Realty, SS Realty Client Testimonial Video.MP4
/public/*.MOV
/public/*.mov

# temp logs and scratch
*.log
.next_dev_log*.txt
scratch/
