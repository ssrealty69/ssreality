#!/bin/sh
# Git Pre-Commit Hook: Automated Secret Scanner
# 1. Block any sensitive environment or key files from being staged
STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
    case "$file" in
        .env* | *.pem | *.key | id_rsa* | *.log)
            echo ""
            echo "================================================================"
            echo "❌ [SECURITY ALERT] COMMIT BLOCKED!"
            echo "Attempted to commit forbidden file: $file"
            echo "Environment and Secret files must NEVER be tracked by Git."
            echo "================================================================"
            echo ""
            exit 1
            ;;
    esac
done

# 2. Scan staged additions for leaked secrets / URIs / Tokens
SECRETS_FOUND=$(git diff --cached -U0 | grep -E "^\+[[:space:]]*.*(mongodb\+srv:\/\/[^[:space:]]+:[^[:space:]]+@|rediss?:\/\/[^[:space:]]+:[^[:space:]]+@|ghp_[a-zA-Z0-9]{20,}|CLOUDINARY_API_SECRET[[:space:]]*=[[:space:]]*['\"][a-zA-Z0-9_-]+['\"]|EMAIL_PASS[[:space:]]*=[[:space:]]*['\"][a-zA-Z0-9_-]+['\"])")

if [ -n "$SECRETS_FOUND" ]; then
    echo ""
    echo "================================================================"
    echo "❌ [SECURITY ALERT] COMMIT BLOCKED BY PRE-COMMIT SCANNER!"
    echo "Hardcoded secret, database URI, or API token detected in code:"
    echo ""
    echo "$SECRETS_FOUND"
    echo ""
    echo "👉 Fix: Remove raw credentials and use process.env.<VAR> instead."
    echo "================================================================"
    echo ""
    exit 1
fi

exit 0
